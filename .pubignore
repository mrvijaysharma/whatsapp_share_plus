# Files and directories to exclude from pub.dev publishing.
# Use this file (not .gitignore) to control what gets published.

# FVM (Flutter Version Management) - checked into git but not needed in package
.fvm/flutter_sdk
.fvm/fvm_config.json
.fvm/

# Build output - never needed in published package
build/

# Maintainer notes - pub reads the files on disk, so these ship even untracked
CLAUDE.md
HANDOFF.md

# IDE
.idea/
*.iml
*.ipr
*.iws
.DS_Store

# Generated API docs
doc/api/

# Other local artifacts. A root .pubignore replaces the root .gitignore for
# publishing, so these patterns have to be repeated here.
*.log
*.class
*.swp
.swiftpm/
migrate_working_dir/
